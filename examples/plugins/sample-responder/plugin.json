{
 "api_version": "1.0",
 "name": "sample-responder",
 "version": "0.1.0",
 "kind": "responder",
 "description": "sample responder plugin",
 "entrypoint": "action.py",
 "runtime": "python",
 "protocol": "ndjson-stdio",
 "capabilities": [],
 "limits": {
  "max_events": 1000,
  "max_line_bytes": 65536,
  "timeout_seconds": 60
 },
 "actions": "actions.json",
 "permissions": {
  "filesystem": [
   "${root}/plugin-samples"
  ]
 }
}
