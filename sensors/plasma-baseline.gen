{"Condition": "$img and $url", "Matches": ["$img: Image ~= '(?i:^c:\\\\windows\\\\sys(tem32|wow64)\\\\certutil\\.exe$)'", "$url: CommandLine ~= '(?i:\\s[-/](urlcache|verifyctl|decode)\\b)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Certutil downloading or decoding.", "Computers": [], "Criticality": 7, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma LOLBin Certutil", "Tags": ["Plasma", "Baseline", "T1140"]}
{"Condition": "$parent and $child", "Matches": ["$parent: ParentImage ~= '(?i:(winword|excel|powerpnt|outlook)\\.exe$)'", "$child: Image ~= '(?i:(cmd|powershell|wscript|cscript|mshta)\\.exe$)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Office document spawning a shell interpreter.", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Office Spawning Shell", "Tags": ["Plasma", "Baseline", "T1566.001"]}
{"Condition": "$img and $sam", "Matches": ["$img: Image ~= '(?i:\\\\reg\\.exe$)'", "$sam: CommandLine ~= '(?i:\\s+save\\s+hklm\\\\(sam|system|security))'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Registry hive saving via reg.exe.", "Computers": [], "Criticality": 9, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma SAM Hive Dump", "Tags": ["Plasma", "Baseline", "T1003.002"]}
{"Condition": "$img and $xfer", "Matches": ["$img: Image ~= '(?i:\\\\bitsadmin\\.exe$)'", "$xfer: CommandLine ~= '(?i:/transfer | /create )'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "BITS job used for transfer execution.", "Computers": [], "Criticality": 7, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Bitsadmin Transfer", "Tags": ["Plasma", "Baseline", "T1197"]}
{"Condition": "$img and $net", "Matches": ["$img: Image ~= '(?i:\\\\mshta\\.exe$)'", "$net: CommandLine ~= '(?i:http|\\\\\\\\)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "mshta with remote content.", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Mshta Network", "Tags": ["Plasma", "Baseline", "T1218.005"]}
{"Condition": "$img and $js", "Matches": ["$img: Image ~= '(?i:\\\\rundll32\\.exe$)'", "$js: CommandLine ~= '(?i:javascript|url\\.dll|RunHTMLApplication)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "rundll32 executing JavaScript or URL payloads.", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Rundll32 JS", "Tags": ["Plasma", "Baseline", "T1218.011"]}
{"Condition": "$img and $add", "Matches": ["$img: Image ~= '(?i:\\\\net1?\\.exe$)'", "$add: CommandLine ~= '(?i:\\s(user|localgroup)\\s+.*[/\\s]add)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "net user/localgroup add from command line.", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Net Account Add", "Tags": ["Plasma", "Baseline", "T1136.001"]}
{"Condition": "$enc", "Matches": ["$enc: CommandLine ~= '(?i:\\s-(?:enc|ec|encodedcommand|e)\\s+[A-Za-z0-9+/]{8,}={0,2})'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Encoded command line on PowerShell (supports -e, -enc, -ec and -encodedcommand).", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Encoded Cmd", "Tags": ["Plasma", "Baseline", "T1027"]}
{"Condition": "$img and $create", "Matches": ["$img: Image ~= '(?i:\\\\schtasks\\.exe$)'", "$create: CommandLine ~= '(?i:/create)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "schtasks creation from command line.", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Scheduled Task Create", "Tags": ["Plasma", "Baseline", "T1053.005"]}
{"Condition": "$img and $proc", "Matches": ["$img: Image ~= '(?i:\\\\wmic\\.exe$)'", "$proc: CommandLine ~= '(?i:process call create)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "wmic process call create.", "Computers": [], "Criticality": 7, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Wmic Process Call", "Tags": ["Plasma", "Baseline", "T1047"]}
{"Condition": "$img and $ext", "Matches": ["$img: Image ~= '(?i:\\\\(cmd|powershell|certutil|bitsadmin|wmic|reg)\\.exe$)'", "$ext: TargetFilename ~= '(?i:\\.(exe|dll|ps1|bat|cmd|vbs|js|jse|wsf|hta|scr|msi|zip|7z|rar)$)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Script host or LOLBin deleting executable/archive artifacts.", "Computers": [], "Criticality": 6, "EventIDs": [23], "Schema": "1.0.0"}, "Name": "Plasma File Delete by LOLBin", "Tags": ["Plasma", "Baseline", "T1070.004"]}
{"Condition": "$reg", "Matches": ["$reg: TargetObject ~= '(?i:\\\\CurrentVersion\\\\Run(Once)?(\\\\|$))'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Registry Run/RunOnce key created or modified.", "Computers": [], "Criticality": 7, "EventIDs": [12, 13], "Schema": "1.0.0"}, "Name": "Plasma Run Key Persistence", "Tags": ["Plasma", "Baseline", "T1547.001"]}
{"Condition": "$svc", "Matches": ["$svc: TargetObject ~= '(?i:\\\\System\\\\(CurrentControlSet|ControlSet00\\d)\\\\Services\\\\[^\\\\]+(\\\\[^\\\\]+)?$)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Service registry key written (new service or ImagePath change).", "Computers": [], "Criticality": 8, "EventIDs": [12, 13], "Schema": "1.0.0"}, "Name": "Plasma Service Registry Persistence", "Tags": ["Plasma", "Baseline", "T1543.003"]}
{"Condition": "$img and $add", "Matches": ["$img: Image ~= '(?i:\\\\net1?\\.exe$)'", "$add: CommandLine ~= '(?i:\\slocalgroup\\s+\"?(administrators|administrators_2|domain admins)\"?\\s+.*add)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Account added to a privileged local/domain group.", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Privileged Group Add", "Tags": ["Plasma", "Baseline", "T1098"]}
{"Condition": "$img", "Matches": ["$img: Image ~= '(?i:\\\\(downloads|programdata|users\\\\public|appdata\\\\(local|roaming)\\\\))'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Process executed from Downloads/Temp/Public (user-execution shape).", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Execution From User Paths", "Tags": ["Plasma", "Baseline", "T1204.002"]}
{"Condition": "$target and $access and !$caller", "Matches": ["$target: TargetImage ~= '(?i:\\\\lsass\\.exe$)'", "$access: GrantedAccess ~= '(?i:^(0x)?(1010|1410|1438|143a|1fffff|1f0fff|1f1fff|1f2fff|1f3fff)$)'", "$caller: Image ~= '(?i:\\\\(werfault|werfaultsecure|msmpeng|mpcmdrun|nissrv)\\.exe$)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Process opened LSASS with credential-dump access rights.", "Computers": [], "Criticality": 9, "EventIDs": [10], "Schema": "1.0.0"}, "Name": "Plasma LSASS Access", "Tags": ["Plasma", "Baseline", "T1003.001"]}
{"Condition": "$img and $sig", "Matches": ["$img: ImageLoaded ~= '(?i:\\\\(users|programdata|temp|downloads)\\\\)'", "$sig: Signed ~= '(?i:false)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Unsigned driver loaded from a user-writable path.", "Computers": [], "Criticality": 8, "EventIDs": [6], "Schema": "1.0.0"}, "Name": "Plasma Unsigned Driver Load", "Tags": ["Plasma", "Baseline", "T1014"]}
{"Condition": "$pipe", "Matches": ["$pipe: PipeName ~= '(?i:\\\\(psexesvc|psexec|paexec|msse-|cobaltstrike|beacon|meterpreter|msagent))'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Named pipe shaped like a lateral-movement or C2 channel.", "Computers": [], "Criticality": 7, "EventIDs": [17, 18], "Schema": "1.0.0"}, "Name": "Plasma Suspicious Named Pipe", "Tags": ["Plasma", "Baseline", "T1021", "T1090"]}
{"Condition": "$img and $path", "Matches": ["$img: Image ~= '(?i:\\\\(cmd|powershell|certutil|bitsadmin|wmic|reg)\\.exe$)'", "$path: TargetFilename ~= '(?i:\\\\(users\\\\[^\\\\]+\\\\(desktop|documents|downloads|pictures|videos)|finance|payroll|hr|legal|backup|shared)\\\\)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "LOLBin deleting a file under a user document, finance, HR, legal, backup or shared path.", "Computers": [], "Criticality": 6, "EventIDs": [23], "Schema": "1.0.0"}, "Name": "Plasma Sensitive File Delete", "Tags": ["Plasma", "Baseline", "T1070.004"]}
{"Condition": "$img and $hide", "Matches": ["$img: Image ~= '(?i:\\\\attrib\\.exe$)'", "$hide: CommandLine ~= '(?i:\\s\\+h\\s)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "attrib +h used to hide a file.", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Hidden File Attribute", "Tags": ["Plasma", "Baseline", "T1564.001"]}
{"Condition": "$reg", "Matches": ["$reg: TargetObject ~= '(?i:\\\\Explorer\\\\Advanced\\\\(HideFileExt|ShowSuperHidden)$)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Explorer file-extension or hidden-file display setting changed.", "Computers": [], "Criticality": 6, "EventIDs": [12, 13], "Schema": "1.0.0"}, "Name": "Plasma Registry Evasion", "Tags": ["Plasma", "Baseline", "T1112", "T1564.001"]}
{"Condition": "$img and !$ok", "Matches": ["$img: Image ~= '(?i)\\\\(svchost|lsass|csrss|winlogon|services|smss|wininit|conhost|taskhostw|spoolsv|lsm)\\.exe$'", "$ok: Image ~= '(?i)^c:\\\\windows\\\\((system32|syswow64)\\\\(svchost|lsass|csrss|winlogon|services|smss|wininit|conhost|taskhostw|spoolsv|lsm)\\.exe$|(winsxs|servicing)\\\\)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "A system-binary name running from outside the Windows system directories.", "Computers": [], "Criticality": 9, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Masqueraded System Binary", "Tags": ["Plasma", "Baseline", "T1036.005"]}
{"Condition": "$sb", "Matches": ["$sb: ScriptBlockText ~= '(?i)(DownloadFile|DownloadString|Net\\.WebClient|\\b(iwr|wget|invoke-webrequest|invoke-restmethod)\\b[^\\n]*https?://)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-PowerShell/Operational"], "Comment": "PowerShell script block downloads content (WebClient, DownloadFile, Invoke-WebRequest).", "Computers": [], "Criticality": 7, "EventIDs": [4104], "Schema": "1.0.0"}, "Name": "Plasma PowerShell Download", "Tags": ["Plasma", "Baseline", "T1105"]}
{"Condition": "$sb", "Matches": ["$sb: ScriptBlockText ~= '(?i)Get-(WmiObject|CimInstance)[^\\n]*(Win32_(ComputerSystem|OperatingSystem|BIOS|Processor|LogicalDisk|NetworkAdapter|Service|UserAccount|Group|Startup|ScheduledTask|Process))'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-PowerShell/Operational"], "Comment": "PowerShell WMI/CIM query against a system-information class.", "Computers": [], "Criticality": 6, "EventIDs": [4104], "Schema": "1.0.0"}, "Name": "Plasma WMI Recon", "Tags": ["Plasma", "Baseline", "T1047", "T1082"]}
{"Condition": "$img and $q", "Matches": ["$img: Image ~= '(?i)\\\\wmic\\.exe$'", "$q: CommandLine ~= '(?i)\\s(os|computersystem|useraccount|group|service|logicaldisk|nic|bios|process)\\s+(get|list|where)'"], "Meta": {"Author": "Plasma", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "wmic used to query system, account, service or disk information.", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Plasma Wmic Recon", "Tags": ["Plasma", "Baseline", "T1047", "T1082"]}
