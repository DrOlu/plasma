{"Name": "Plasma LOLBin Certutil", "Tags": ["Plasma", "Baseline", "T1140"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 7, "Author": "Plasma", "Comment": "Certutil downloading or decoding.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:^c:\\\\windows\\\\sys(tem32|wow64)\\\\certutil\\.exe$)'", "$url: CommandLine ~= '(?i: -urlcache | -decode )'"], "Condition": "$img and $url"}
{"Name": "Plasma Office Spawning Shell", "Tags": ["Plasma", "Baseline", "T1566.001"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 8, "Author": "Plasma", "Comment": "Office document spawning a shell interpreter.", "Schema": "1.0.0"}, "Matches": ["$parent: ParentImage ~= '(?i:(winword|excel|powerpnt|outlook)\\.exe$)'", "$child: Image ~= '(?i:(cmd|powershell|wscript|cscript|mshta)\\.exe$)'"], "Condition": "$parent and $child"}
{"Name": "Plasma SAM Hive Dump", "Tags": ["Plasma", "Baseline", "T1003.002"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 9, "Author": "Plasma", "Comment": "Registry hive saving via reg.exe.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\reg\\.exe$)'", "$sam: CommandLine ~= '(?i:\\s+save\\s+hklm\\\\(sam|system))'"], "Condition": "$img and $sam"}
{"Name": "Plasma Bitsadmin Transfer", "Tags": ["Plasma", "Baseline", "T1197"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 7, "Author": "Plasma", "Comment": "BITS job used for transfer execution.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\bitsadmin\\.exe$)'", "$xfer: CommandLine ~= '(?i:/transfer | /create )'"], "Condition": "$img and $xfer"}
{"Name": "Plasma Mshta Network", "Tags": ["Plasma", "Baseline", "T1218.005"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 8, "Author": "Plasma", "Comment": "mshta with remote content.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\mshta\\.exe$)'", "$net: CommandLine ~= '(?i:http|\\\\\\\\)'"], "Condition": "$img and $net"}
{"Name": "Plasma Rundll32 JS", "Tags": ["Plasma", "Baseline", "T1218.011"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 8, "Author": "Plasma", "Comment": "rundll32 executing JavaScript or URL payloads.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\rundll32\\.exe$)'", "$js: CommandLine ~= '(?i:javascript|url\\.dll|RunHTMLApplication)'"], "Condition": "$img and $js"}
{"Name": "Plasma Net Account Add", "Tags": ["Plasma", "Baseline", "T1136.001"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 8, "Author": "Plasma", "Comment": "net user/localgroup add from command line.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\net1?\\.exe$)'", "$add: CommandLine ~= '(?i:\\s(user|localgroup)\\s+.*[/\\s]add)'"], "Condition": "$img and $add"}
{"Name": "Plasma Encoded Cmd", "Tags": ["Plasma", "Baseline", "T1027"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 6, "Author": "Plasma", "Comment": "Encoded command line on PowerShell.", "Schema": "1.0.0"}, "Matches": ["$enc: CommandLine ~= '(?i:\\s-(enc|ec|encodedcommand)\\s)'"], "Condition": "$enc"}
{"Name": "Plasma Scheduled Task Create", "Tags": ["Plasma", "Baseline", "T1053.005"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 6, "Author": "Plasma", "Comment": "schtasks creation from command line.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\schtasks\\.exe$)'", "$create: CommandLine ~= '(?i:/create)'"], "Condition": "$img and $create"}
{"Name": "Plasma Wmic Process Call", "Tags": ["Plasma", "Baseline", "T1047"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 7, "Author": "Plasma", "Comment": "wmic process call create.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\wmic\\.exe$)'", "$proc: CommandLine ~= '(?i:process call create)'"], "Condition": "$img and $proc"}
{"Name": "Plasma File Delete by LOLBin", "Tags": ["Plasma", "Baseline", "T1070.004"], "Meta": {"EventIDs": [23, 26], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 6, "Author": "Plasma", "Comment": "Script host or LOLBin deleting executable/archive artifacts.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\(cmd|powershell|certutil|bitsadmin|wmic|reg)\\.exe$)'", "$ext: TargetFilename ~= '(?i:\\.(exe|dll|ps1|bat|cmd|vbs|js|jse|wsf|hta|scr|msi|zip|7z|rar)$)'"], "Condition": "$img and $ext"}
{"Name": "Plasma Run Key Persistence", "Tags": ["Plasma", "Baseline", "T1547.001"], "Meta": {"EventIDs": [12, 13], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 7, "Author": "Plasma", "Comment": "Registry Run/RunOnce key created or modified.", "Schema": "1.0.0"}, "Matches": ["$reg: TargetObject ~= '(?i:\\\\CurrentVersion\\\\Run(Once)?(\\\\|$))'"], "Condition": "$reg"}
{"Name": "Plasma Service Registry Persistence", "Tags": ["Plasma", "Baseline", "T1543.003"], "Meta": {"EventIDs": [12, 13], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 8, "Author": "Plasma", "Comment": "Service registry key written (new service or ImagePath change).", "Schema": "1.0.0"}, "Matches": ["$svc: TargetObject ~= '(?i:\\\\System\\\\CurrentControlSet\\\\Services\\\\)'"], "Condition": "$svc"}
{"Name": "Plasma Privileged Group Add", "Tags": ["Plasma", "Baseline", "T1098"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 8, "Author": "Plasma", "Comment": "Account added to a privileged local/domain group.", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\net1?\\.exe$)'", "$add: CommandLine ~= '(?i:\\slocalgroup\\s+(administrators|administrators_2|domain admins)\\s+.*add)'"], "Condition": "$img and $add"}
{"Name": "Plasma Execution From User Paths", "Tags": ["Plasma", "Baseline", "T1204.002"], "Meta": {"EventIDs": [1], "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Computers": [], "Criticality": 6, "Author": "Plasma", "Comment": "Process executed from Downloads/Temp/Public (user-execution shape).", "Schema": "1.0.0"}, "Matches": ["$img: Image ~= '(?i:\\\\(downloads|appdata\\\\local\\\\temp|users\\\\public)\\\\)'"], "Condition": "$img"}
