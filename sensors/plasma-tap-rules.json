{
  "version": 1,
  "description": "Plasma ETW tap rules. Deterministic, manifest-verified, bundled. Security-channel audit events are covered by `plasma identity pull` (Event Log API) \u2014 audit events are not re-emitted to realtime ETW.",
  "providers": {
    "powershell": "Microsoft-Windows-PowerShell",
    "wmi": "Microsoft-Windows-WMI-Activity",
    "dns": "Microsoft-Windows-DNS-Client",
    "dotnet": "Microsoft-Windows-DotNETRuntime",
    "schannel": "Microsoft-Windows-Schannel",
    "security": "Microsoft-Windows-Security-Auditing"
  },
  "rules": [
    {
      "name": "ps-base64-decode",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "FromBase64String",
      "severity": "high",
      "technique": "T1027"
    },
    {
      "name": "ps-webclient-download",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Net.WebClient",
      "severity": "high",
      "technique": "T1105"
    },
    {
      "name": "ps-downloadfile",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "DownloadFile",
      "severity": "high",
      "technique": "T1105"
    },
    {
      "name": "ps-invoke-expression",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Invoke-Expression",
      "severity": "medium",
      "technique": "T1059.001"
    },
    {
      "name": "ps-encoded-command",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "-enc ",
      "severity": "medium",
      "technique": "T1027"
    },
    {
      "name": "ps-register-scheduled-task",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Register-ScheduledTask",
      "severity": "high",
      "technique": "T1053.005"
    },
    {
      "name": "ps-scheduled-job-hidden",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "New-ScheduledTaskSettingsSet",
      "severity": "medium",
      "technique": "T1053.005"
    },
    {
      "name": "ps-local-group-add",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Add-LocalGroupMember",
      "severity": "high",
      "technique": "T1078.003"
    },
    {
      "name": "wmi-event-filter",
      "provider": "wmi",
      "event_id": 0,
      "field": "*",
      "substr": "__EventFilter",
      "severity": "high",
      "technique": "T1546.003"
    },
    {
      "name": "wmi-activescript-consumer",
      "provider": "wmi",
      "event_id": 0,
      "field": "*",
      "substr": "ActiveScriptEventConsumer",
      "severity": "high",
      "technique": "T1546.003"
    },
    {
      "name": "wmi-cmdline-consumer",
      "provider": "wmi",
      "event_id": 0,
      "field": "*",
      "substr": "CommandLineEventConsumer",
      "severity": "high",
      "technique": "T1546.003"
    },
    {
      "name": "dns-ddns-tunnel",
      "provider": "dns",
      "event_id": 0,
      "field": "QueryName",
      "substr": ".ddns.",
      "severity": "medium",
      "technique": "T1071.004"
    },
    {
      "name": "dns-tunnel-domain-top",
      "provider": "dns",
      "event_id": 0,
      "field": "QueryName",
      "substr": ".top",
      "severity": "low",
      "technique": "T1071.004"
    },
    {
      "name": "dotnet-assembly-load",
      "provider": "dotnet",
      "event_id": 154,
      "field": "*",
      "substr": "",
      "severity": "medium",
      "technique": "T1620"
    },
    {
      "name": "ps-invoke-mimikatz",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Invoke-Mimikatz",
      "severity": "critical",
      "technique": "T1003.002"
    },
    {
      "name": "ps-minidump",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "MiniDumpWriteDump",
      "severity": "high",
      "technique": "T1003.001"
    },
    {
      "name": "ps-reg-save-hive",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "reg save",
      "severity": "high",
      "technique": "T1003.002"
    },
    {
      "name": "ps-token-manipulation",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Invoke-TokenManipulation",
      "severity": "high",
      "technique": "T1134"
    },
    {
      "name": "ps-amsi-bypass",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "amsiInitFailed",
      "severity": "high",
      "technique": "T1562.001"
    },
    {
      "name": "ps-executionpolicy-bypass",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "set-executionpolicy bypass",
      "severity": "medium",
      "technique": "T1562.001"
    },
    {
      "name": "ps-hidden-window",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "-windowstyle hidden",
      "severity": "medium",
      "technique": "T1564.003"
    },
    {
      "name": "ps-downloadstring",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "DownloadString(",
      "severity": "high",
      "technique": "T1105"
    },
    {
      "name": "ps-iex-webclient-cradle",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "IEX(New-Object Net.WebClient",
      "severity": "critical",
      "technique": "T1059.001"
    },
    {
      "name": "ps-tcpclient",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Sockets.TcpClient",
      "severity": "medium",
      "technique": "T1071.001"
    },
    {
      "name": "ps-invoke-shellcode",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Invoke-Shellcode",
      "severity": "critical",
      "technique": "T1055"
    },
    {
      "name": "ps-invoke-dllinjection",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Invoke-DllInjection",
      "severity": "critical",
      "technique": "T1055.001"
    },
    {
      "name": "ps-compress-archive",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Compress-Archive",
      "severity": "medium",
      "technique": "T1560.001"
    },
    {
      "name": "ps-invoke-wmimethod",
      "provider": "powershell",
      "event_id": 4104,
      "field": "ScriptBlockText",
      "substr": "Invoke-WmiMethod",
      "severity": "medium",
      "technique": "T1047"
    },
    {
      "name": "dns-ngrok",
      "provider": "dns",
      "event_id": 0,
      "field": "QueryName",
      "substr": "ngrok",
      "severity": "medium",
      "technique": "T1071.001"
    },
    {
      "name": "dns-trycloudflare-tunnel",
      "provider": "dns",
      "event_id": 0,
      "field": "QueryName",
      "substr": "trycloudflare.com",
      "severity": "medium",
      "technique": "T1071.001"
    },
    {
      "name": "dns-duckdns",
      "provider": "dns",
      "event_id": 0,
      "field": "QueryName",
      "substr": ".duckdns.org",
      "severity": "low",
      "technique": "T1071.001"
    }
  ]
}
