{"Condition": "($selection_image and $selection_commandline)", "Matches": ["$selection_image: Image ~= '(?i:\\\\shutdown\\.exe$)'", "$selection_commandline: CommandLine ~= '(?i:/l)'"], "Meta": {"Author": "frack113", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects the rare use of the command line tool shutdown to logoff a user (source: proc_creation_win_shutdown_logoff.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Suspicious Execution of Shutdown to Log Out", "Tags": ["Sigma", "SigmaHQ", "T1529"]}
{"Condition": "($selection_image)", "Matches": ["$selection_image: Image ~= '(?i:^C:\\\\Windows\\\\System32\\\\wpbbin\\.exe$)'"], "Meta": {"Author": "Nasreddine Bencherchali (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects execution of the binary \"wpbbin\" which is used as part of the UEFI based persistence method described in the reference section (source: proc_creation_win_wpbbin_potential_persistence.yml)", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: UEFI Persistence Via Wpbbin - ProcessCreation", "Tags": ["Sigma", "SigmaHQ", "T1542.001"]}
