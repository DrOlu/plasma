{"Condition": "($selection_image and $selection_imageloaded)", "Matches": ["$selection_image: Image ~= '(?:(?i:\\\\excel\\.exe$)|(?i:\\\\mspub\\.exe$)|(?i:\\\\onenote\\.exe$)|(?i:\\\\onenoteim\\.exe$)|(?i:\\\\outlook\\.exe$)|(?i:\\\\powerpnt\\.exe$)|(?i:\\\\winword\\.exe$))'", "$selection_imageloaded: ImageLoaded ~= '(?i:^C:\\\\Windows\\\\Microsoft\\.NET\\\\assembly\\\\GAC_MSIL)'"], "Meta": {"Author": "Antonlovesdnb", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects any GAC DLL being loaded by an Office Product (source: image_load_office_dotnet_gac_dll_load.yml)", "Computers": [], "Criticality": 8, "EventIDs": [7], "Schema": "1.0.0"}, "Name": "Sigma: GAC DLL Loaded Via Office Applications", "Tags": ["Sigma", "SigmaHQ", "T1204.002"]}
{"Condition": "($selection_parentimage and $selection_parentcommandline)", "Matches": ["$selection_parentimage: ParentImage ~= '(?:(?i:\\\\java\\.exe$)|(?i:\\\\javaw\\.exe$))'", "$selection_parentcommandline: ParentCommandLine ~= '(?i:SysAidServer)'"], "Meta": {"Author": "Florian Roth (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects suspicious child processes of SysAidServer (as seen in MERCURY threat actor intrusions) (source: proc_creation_win_java_sysaidserver_susp_child_process.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Suspicious SysAidServer Child", "Tags": ["Sigma", "SigmaHQ", "T1210"]}
{"Condition": "($contains_winrm_commandline) and ( ($contains_format_pretty_arg_commandline) and ! ($image_from_system_folder_image) )", "Matches": ["$contains_format_pretty_arg_commandline: CommandLine ~= '(?:(?i:format:pretty)|(?i:format:\"pretty\")|(?i:format:\"text\")|(?i:format:text))'", "$image_from_system_folder_image: Image ~= '(?:(?i:^C:\\\\Windows\\\\System32\\\\)|(?i:^C:\\\\Windows\\\\SysWOW64\\\\))'", "$contains_winrm_commandline: CommandLine ~= '(?i:winrm)'"], "Meta": {"Author": "Julia Fomina, oscd.community", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects execution of attacker-controlled WsmPty.xsl or WsmTxt.xsl via winrm.vbs and copied cscript.exe (can be renamed) (source: proc_creation_win_winrm_awl_bypass.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: AWL Bypass with Winrm.vbs and Malicious WsmPty.xsl/WsmTxt.xsl", "Tags": ["Sigma", "SigmaHQ", "T1216"]}
