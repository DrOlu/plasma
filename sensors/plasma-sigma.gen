{"Condition": "($selection_image and $selection_commandline)", "Matches": ["$selection_image: Image ~= '(?i:\\\\msxsl\\.exe$)'", "$selection_commandline: CommandLine ~= '(?i:http)'"], "Meta": {"Author": "Swachchhanda Shrawan Poudel", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects the execution of the \"msxsl\" binary with an \"http\" keyword in the command line. This might indicate a potential remote execution of XSL files. (source: proc_creation_win_msxsl_remote_execution.yml)", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Remote XSL Execution Via Msxsl.EXE", "Tags": ["Sigma", "SigmaHQ", "T1220"]}
