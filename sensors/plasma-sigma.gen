{"Condition": "($selection_parentimage) and ! ($filter_image)", "Matches": ["$selection_parentimage: ParentImage ~= '(?i:\\\\dns\\.exe$)'", "$filter_image: Image ~= '(?i:\\\\conhost\\.exe$)'"], "Meta": {"Author": "Tim Rauch, Elastic (idea)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects an unexpected process spawning from dns.exe which may indicate activity related to remote code execution or other forms of exploitation as seen in CVE-2020-1350 (SigRed) (source: proc_creation_win_dns_susp_child_process.yml)", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Unusual Child Process of dns.exe", "Tags": ["Sigma", "SigmaHQ", "T1133"]}
