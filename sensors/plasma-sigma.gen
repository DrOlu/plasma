{"Condition": "(($selection_1_image) or ($selection_2_originalfilename) or ($selection_3_description) or ($selection_4_commandline))", "Matches": ["$selection_1_image: Image ~= '(?i:\\\\Rubeus\\.exe$)'", "$selection_2_originalfilename: OriginalFileName ~= '(?i:^Rubeus\\.exe$)'", "$selection_3_description: Description ~= '(?i:^Rubeus$)'", "$selection_4_commandline: CommandLine ~= '(?:(?i:asreproast\\ )|(?i:dump\\ /service:krbtgt\\ )|(?i:dump\\ /luid:0x)|(?i:kerberoast\\ )|(?i:createnetonly\\ /program:)|(?i:ptt\\ /ticket:)|(?i:/impersonateuser:)|(?i:renew\\ /ticket:)|(?i:asktgt\\ /user:)|(?i:harvest\\ /interval:)|(?i:s4u\\ /user:)|(?i:s4u\\ /ticket:)|(?i:hash\\ /password:)|(?i:golden\\ /aes256:)|(?i:silver\\ /user:))'"], "Meta": {"Author": "Florian Roth (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects the execution of the hacktool Rubeus via PE information of command line parameters (source: proc_creation_win_hktl_rubeus.yml)", "Computers": [], "Criticality": 9, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: HackTool - Rubeus Execution", "Tags": ["Sigma", "SigmaHQ", "T1003", "T1558.003", "T1550.003"]}
