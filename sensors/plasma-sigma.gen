{"Condition": "($selection_image and $selection_imageloaded and $selection_imageloaded_2)", "Matches": ["$selection_image: Image ~= '(?i:\\\\BaaUpdate\\.exe$)'", "$selection_imageloaded: ImageLoaded ~= '(?i:\\.dll$)'", "$selection_imageloaded_2: ImageLoaded ~= '(?:(?i::\\\\Perflogs\\\\)|(?i::\\\\Users\\\\Default\\\\)|(?i::\\\\Users\\\\Public\\\\)|(?i::\\\\Windows\\\\Temp\\\\)|(?i:\\\\AppData\\\\Local\\\\Temp\\\\)|(?i:\\\\AppData\\\\Roaming\\\\)|(?i:\\\\Contacts\\\\)|(?i:\\\\Favorites\\\\)|(?i:\\\\Favourites\\\\)|(?i:\\\\Links\\\\)|(?i:\\\\Music\\\\)|(?i:\\\\Pictures\\\\)|(?i:\\\\ProgramData\\\\)|(?i:\\\\Temporary\\ Internet)|(?i:\\\\Videos\\\\))'"], "Meta": {"Author": "Swachchhanda Shrawan Poudel (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects BitLocker Access Agent Update Utility (baaupdate.exe) loading DLLs from suspicious locations that are publicly writable which could indicate an attempt to lateral movement via BitLocker DCOM & COM Hijacking.\nThis technique abuses COM Classes configured as INTERACTIVE USER to spawn processes ", "Computers": [], "Criticality": 8, "EventIDs": [7], "Schema": "1.0.0"}, "Name": "Sigma: BaaUpdate.exe Suspicious DLL Load", "Tags": ["Sigma", "SigmaHQ", "T1218", "T1021.003"]}
{"Condition": "($selection_parentimage and $selection_image and $selection_commandline)", "Matches": ["$selection_parentimage: ParentImage ~= '(?i:\\\\onenote\\.exe$)'", "$selection_image: Image ~= '(?:(?i:\\\\cmd\\.exe$)|(?i:\\\\cscript\\.exe$)|(?i:\\\\mshta\\.exe$)|(?i:\\\\powershell\\.exe$)|(?i:\\\\pwsh\\.exe$)|(?i:\\\\wscript\\.exe$))'", "$selection_commandline: CommandLine ~= '(?:(?i:\\\\exported\\\\)|(?i:\\\\onenoteofflinecache_files\\\\))'"], "Meta": {"Author": "@kostastsale", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects the execution of malicious OneNote documents that contain embedded scripts.\nWhen a user clicks on a OneNote attachment and then on the malicious link inside the \".one\" file, it exports and executes the malicious embedded script from specific directories.\n (source: proc_creation_win_office_on", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: OneNote.EXE Execution of Malicious Embedded Scripts", "Tags": ["Sigma", "SigmaHQ", "T1218.001"]}
{"Condition": "($selection_calltrace)", "Matches": ["$selection_calltrace: CallTrace ~= '(?i:cmlua\\.dll)'"], "Meta": {"Author": "Nik Seetharaman", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects various indicators of Microsoft Connection Manager Profile Installer execution (source: proc_access_win_cmstp_execution_by_access.yml)", "Computers": [], "Criticality": 8, "EventIDs": [10], "Schema": "1.0.0"}, "Name": "Sigma: CMSTP Execution Process Access", "Tags": ["Sigma", "SigmaHQ", "T1218.003", "T1559.001"]}
