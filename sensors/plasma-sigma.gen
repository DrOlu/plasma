{"Condition": "($selection_image and $selection_commandline_all0 and $selection_commandline_all1 and $selection_commandline_all2)", "Matches": ["$selection_image: Image ~= '(?i:\\\\cmd\\.exe$)'", "$selection_commandline_all0: CommandLine ~= '(?i:http)'", "$selection_commandline_all1: CommandLine ~= '(?i:://)'", "$selection_commandline_all2: CommandLine ~= '(?i:%AppData%)'"], "Meta": {"Author": "Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects a suspicious command line execution that includes an URL and AppData string in the command line parameters as used by several droppers (js/vbs > powershell) (source: proc_creation_win_cmd_http_appdata.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Command Line Execution with Suspicious URL and AppData Strings", "Tags": ["Sigma", "SigmaHQ", "T1059.003", "T1059.001", "T1105"]}
