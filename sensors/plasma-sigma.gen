{"Condition": "($selection_image and $selection_commandline_all0 and $selection_commandline_all1 and $selection_commandline_all2 and $selection_commandline_all3 and $selection_commandline_all4)", "Matches": ["$selection_image: Image ~= '(?i:\\\\TacticalAgent\\\\tacticalrmm\\.exe)'", "$selection_commandline_all0: CommandLine ~= '(?i:\\-\\-api)'", "$selection_commandline_all1: CommandLine ~= '(?i:\\-\\-auth)'", "$selection_commandline_all2: CommandLine ~= '(?i:\\-\\-client\\-id)'", "$selection_commandline_all3: CommandLine ~= '(?i:\\-\\-site\\-id)'", "$selection_commandline_all4: CommandLine ~= '(?i:\\-\\-agent\\-type)'"], "Meta": {"Author": "Ahmed Nosir (@egycondor)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects TacticalRMM agent installations where the --api, --auth, and related flags are used on the command line.\nThese parameters configure the agent to connect to a specific RMM server with authentication, client ID, and site ID.\nThis technique could indicate a threat actor attempting to register t", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Remote Access Tool - TacticalRMM Agent Registration to Potentially Attacker-Controlled Server", "Tags": ["Sigma", "SigmaHQ", "T1219", "T1105"]}
