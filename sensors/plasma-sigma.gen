{"Condition": "($selection_targetobject) and ! ($filter_details)", "Matches": ["$selection_targetobject: TargetObject ~= '(?i:^HKLM\\\\System\\\\CurrentControlSet\\\\Services\\\\Fax\\\\ObjectName$)'", "$filter_details: Details ~= '(?i:NetworkService)'"], "Meta": {"Author": "frack113", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detect change of the user account associated with the FAX service to avoid the escalation problem. (source: registry_set_fax_change_service_user.yml)", "Computers": [], "Criticality": 8, "EventIDs": [12, 13, 14], "Schema": "1.0.0"}, "Name": "Sigma: Change User Account Associated with the FAX Service", "Tags": ["Sigma", "SigmaHQ", "T1112"]}
