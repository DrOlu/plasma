{"Condition": "(($selection_1_image) or ($selection_2_product))", "Matches": ["$selection_1_image: Image ~= '(?i:\\\\SharpChisel\\.exe$)'", "$selection_2_product: Product ~= '(?i:^SharpChisel$)'"], "Meta": {"Author": "Nasreddine Bencherchali (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects usage of the Sharp Chisel via the commandline arguments (source: proc_creation_win_hktl_sharp_chisel.yml)", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: HackTool - SharpChisel Execution", "Tags": ["Sigma", "SigmaHQ", "T1090.001"]}
{"Condition": "(($selection_1_description) or ($selection_2_product) or ($selection_3_image))", "Matches": ["$selection_1_description: Description ~= '(?i:^Tor\\ Browser$)'", "$selection_2_product: Product ~= '(?i:^Tor\\ Browser$)'", "$selection_3_image: Image ~= '(?:(?i:\\\\tor\\.exe$)|(?i:\\\\Tor\\ Browser\\\\Browser\\\\firefox\\.exe$))'"], "Meta": {"Author": "frack113", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects the use of Tor or Tor-Browser to connect to onion routing networks (source: proc_creation_win_browsers_tor_execution.yml)", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Tor Client/Browser Execution", "Tags": ["Sigma", "SigmaHQ", "T1090.003"]}
{"Condition": "($selection_commandline_all0 and $selection_commandline_all1 and $selection_commandline_2)", "Matches": ["$selection_commandline_all0: CommandLine ~= '(?i:\\ tunnel\\ )'", "$selection_commandline_all1: CommandLine ~= '(?i:cleanup\\ )'", "$selection_commandline_2: CommandLine ~= '(?:(?i:\\-config\\ )|(?i:\\-connector\\-id\\ ))'"], "Meta": {"Author": "Nasreddine Bencherchali (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects execution of the \"cloudflared\" tool with the tunnel \"cleanup\" flag in order to cleanup tunnel connections. (source: proc_creation_win_cloudflared_tunnel_cleanup.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Cloudflared Tunnel Connections Cleanup", "Tags": ["Sigma", "SigmaHQ", "T1102", "T1090", "T1572"]}
{"Condition": "(($selection_1_originalfilename) or ($selection_2_image))", "Matches": ["$selection_1_originalfilename: OriginalFileName ~= '(?i:^finger\\.exe$)'", "$selection_2_image: Image ~= '(?i:\\\\finger\\.exe$)'"], "Meta": {"Author": "Florian Roth (Nextron Systems), omkar72, oscd.community", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects execution of the \"finger.exe\" utility.\nFinger.EXE or \"TCPIP Finger Command\" is an old utility that is still present on modern Windows installation. It Displays information about users on a specified remote computer (typically a UNIX computer) that is running the finger service or daemon.\nDue", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Finger.EXE Execution", "Tags": ["Sigma", "SigmaHQ", "T1105"]}
{"Condition": "($selection_calltrace and $selection_grantedaccess)", "Matches": ["$selection_calltrace: CallTrace ~= '(?i:^C:\\\\Windows\\\\SYSTEM32\\\\ntdll\\.dll\\+[a-z0-9]{4,6}\\|C:\\\\Windows\\\\System32\\\\KERNELBASE\\.dll\\+[a-z0-9]{4,6}\\|UNKNOWN\\([A-Z0-9]{16}\\)$)'", "$selection_grantedaccess: GrantedAccess ~= '(?:(?i:^0x1028$)|(?i:^0x1fffff$))'"], "Meta": {"Author": "Christian Burkard (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects a typical pattern of a CobaltStrike BOF which inject into other processes (source: proc_access_win_hktl_cobaltstrike_bof_injection_pattern.yml)", "Computers": [], "Criticality": 8, "EventIDs": [10], "Schema": "1.0.0"}, "Name": "Sigma: HackTool - CobaltStrike BOF Injection Pattern", "Tags": ["Sigma", "SigmaHQ", "T1106", "T1685"]}
{"Condition": "($selection_commandline_all0 and $selection_commandline_all1 and $selection_commandline_2)", "Matches": ["$selection_commandline_all0: CommandLine ~= '(?i:\\-u\\ )'", "$selection_commandline_all1: CommandLine ~= '(?i:\\-p\\ )'", "$selection_commandline_2: CommandLine ~= '(?:(?i:\\^USER\\^)|(?i:\\^PASS\\^))'"], "Meta": {"Author": "Vasiliy Burov", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects command line parameters used by Hydra password guessing hack tool (source: proc_creation_win_hktl_hydra.yml)", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: HackTool - Hydra Password Bruteforce Execution", "Tags": ["Sigma", "SigmaHQ", "T1110", "T1110.001"]}
{"Condition": "($selection_targetobject and $selection_targetobject_2)", "Matches": ["$selection_targetobject: TargetObject ~= '(?i:SYSTEM\\\\)'", "$selection_targetobject_2: TargetObject ~= '(?i:\\\\services\\\\localNETService$)'"], "Meta": {"Author": "Trent Liffick", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects the presence of a registry key created during Azorult execution (source: registry_event_mal_azorult.yml)", "Computers": [], "Criticality": 9, "EventIDs": [12, 13], "Schema": "1.0.0"}, "Name": "Sigma: Registry Entries For Azorult Malware", "Tags": ["Sigma", "SigmaHQ", "T1112"]}
{"Condition": "($selection_targetobject and $selection_details)", "Matches": ["$selection_targetobject: TargetObject ~= '(?i:\\\\Control\\\\Session\\ Manager\\\\Configuration\\ Manager\\\\EnablePeriodicBackup$)'", "$selection_details: Details ~= '(?i:^DWORD\\ \\(0x00000001\\)$)'"], "Meta": {"Author": "Nasreddine Bencherchali (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects the enabling of the \"EnablePeriodicBackup\" registry value. Once enabled, The OS will backup System registry hives on restarts to the \"C:\\Windows\\System32\\config\\RegBack\" folder. Windows creates a \"RegIdleBackup\" task to manage subsequent backups.\nRegistry backup was a default behavior on Win", "Computers": [], "Criticality": 6, "EventIDs": [12, 13, 14], "Schema": "1.0.0"}, "Name": "Sigma: Periodic Backup For System Registry Hives Enabled", "Tags": ["Sigma", "SigmaHQ", "T1113"]}
{"Condition": "($selection_commandline)", "Matches": ["$selection_commandline: CommandLine ~= '(?i:Get\\-Clipboard)'"], "Meta": {"Author": "Nasreddine Bencherchali (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects usage of the 'Get-Clipboard' cmdlet via CLI (source: proc_creation_win_powershell_get_clipboard.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: PowerShell Get-Clipboard Cmdlet Via CLI", "Tags": ["Sigma", "SigmaHQ", "T1115"]}
{"Condition": "($selection_commandline)", "Matches": ["$selection_commandline: CommandLine ~= '(?:(?i:WindowsAudioDevice\\-Powershell\\-Cmdlet)|(?i:Toggle\\-AudioDevice)|(?i:Get\\-AudioDevice\\ )|(?i:Set\\-AudioDevice\\ )|(?i:Write\\-AudioDevice\\ ))'"], "Meta": {"Author": "E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community, Nasreddine Bencherchali (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects audio capture via PowerShell Cmdlet. (source: proc_creation_win_powershell_audio_capture.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Audio Capture via PowerShell", "Tags": ["Sigma", "SigmaHQ", "T1123"]}
{"Condition": "($selection_image and $selection_image_2 and $selection_commandline)", "Matches": ["$selection_image: Image ~= '(?:(?i::\\\\Windows\\\\Microsoft\\.NET\\\\Framework\\\\)|(?i::\\\\Windows\\\\Microsoft\\.NET\\\\Framework64\\\\)|(?i::\\\\Windows\\\\Microsoft\\.NET\\\\FrameworkArm\\\\)|(?i::\\\\Windows\\\\Microsoft\\.NET\\\\FrameworkArm64\\\\))'", "$selection_image_2: Image ~= '(?i:\\\\aspnet_compiler\\.exe$)'", "$selection_commandline: CommandLine ~= '(?:(?i:\\\\Users\\\\Public\\\\)|(?i:\\\\AppData\\\\Local\\\\Temp\\\\)|(?i:\\\\AppData\\\\Local\\\\Roaming\\\\)|(?i::\\\\Temp\\\\)|(?i::\\\\Windows\\\\Temp\\\\)|(?i::\\\\Windows\\\\System32\\\\Tasks\\\\)|(?i::\\\\Windows\\\\Tasks\\\\))'"], "Meta": {"Author": "Nasreddine Bencherchali (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects execution of \"aspnet_compiler.exe\" with potentially suspicious paths for compilation. (source: proc_creation_win_aspnet_compiler_susp_paths.yml)", "Computers": [], "Criticality": 8, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Potentially Suspicious ASP.NET Compilation Via AspNetCompiler", "Tags": ["Sigma", "SigmaHQ", "T1127"]}
