{"Condition": "($selection_image and $selection_commandline)", "Matches": ["$selection_image: Image ~= '(?i:\\\\SoundRecorder\\.exe$)'", "$selection_commandline: CommandLine ~= '(?i:/FILE)'"], "Meta": {"Author": "E.M. Anhaus (originally from Atomic Blue Detections, Endgame), oscd.community", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detect attacker collecting audio via SoundRecorder application. (source: proc_creation_win_soundrecorder_audio_capture.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Audio Capture via SoundRecorder", "Tags": ["Sigma", "SigmaHQ", "T1123"]}
{"Condition": "($selection_image and $selection_targetfilename)", "Matches": ["$selection_image: Image ~= '(?i:\\\\ArcSOC\\.exe$)'", "$selection_targetfilename: TargetFilename ~= '(?:(?i:\\.ahk$)|(?i:\\.aspx$)|(?i:\\.au3$)|(?i:\\.bat$)|(?i:\\.cmd$)|(?i:\\.dll$)|(?i:\\.exe$)|(?i:\\.hta$)|(?i:\\.js$)|(?i:\\.ps1$)|(?i:\\.py$)|(?i:\\.vbe$)|(?i:\\.vbs$)|(?i:\\.wsf$))'"], "Meta": {"Author": "Micah Babinski", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects instances where the ArcGIS Server process ArcSOC.exe, which hosts REST services running on an ArcGIS\nserver, creates a file with suspicious file type, indicating that it may be an executable, script file,\nor otherwise unusual.\n (source: file_event_win_arcsoc_susp_file_created.yml)", "Computers": [], "Criticality": 8, "EventIDs": [11], "Schema": "1.0.0"}, "Name": "Sigma: Suspicious File Created by ArcSOC.exe", "Tags": ["Sigma", "SigmaHQ", "T1127", "T1105", "T1133"]}
{"Condition": "($selection_commandline_all0 and $selection_commandline_all1 and $selection_commandline_all2)", "Matches": ["$selection_commandline_all0: CommandLine ~= '(?i:FromBase64String)'", "$selection_commandline_all1: CommandLine ~= '(?i:MemoryStream)'", "$selection_commandline_all2: CommandLine ~= '(?i:H4sI)'"], "Meta": {"Author": "frack113", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects attempts of decoding a base64 Gzip archive via PowerShell. This technique is often used as a method to load malicious content into memory afterward. (source: proc_creation_win_powershell_frombase64string_archive.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Suspicious FromBase64String Usage On Gzip Archive - Process Creation", "Tags": ["Sigma", "SigmaHQ", "T1132.001"]}
{"Condition": "($selection_commandline_all0 and $selection_commandline_all1 and $selection_commandline_all2 and $selection_commandline_all3 and $selection_commandline_all4)", "Matches": ["$selection_commandline_all0: CommandLine ~= '(?i:e=Access\\&)'", "$selection_commandline_all1: CommandLine ~= '(?i:y=Guest\\&)'", "$selection_commandline_all2: CommandLine ~= '(?i:\\&p=)'", "$selection_commandline_all3: CommandLine ~= '(?i:\\&c=)'", "$selection_commandline_all4: CommandLine ~= '(?i:\\&k=)'"], "Meta": {"Author": "Florian Roth (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects ScreenConnect program starts that establish a remote access to a system. (source: proc_creation_win_remote_access_tools_screenconnect_installation_cli_param.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Remote Access Tool - ScreenConnect Installation Execution", "Tags": ["Sigma", "SigmaHQ", "T1133"]}
{"Condition": "($selection_targetobject and $selection_details)", "Matches": ["$selection_targetobject: TargetObject ~= '(?i:\\\\Outlook\\\\LoadMacroProviderOnBoot$)'", "$selection_details: Details ~= '(?i:0x00000001)'"], "Meta": {"Author": "Nasreddine Bencherchali (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects the modification of Outlook setting \"LoadMacroProviderOnBoot\" which if enabled allows the automatic loading of any configured VBA project/module (source: registry_set_office_outlook_enable_load_macro_provider_on_boot.yml)", "Computers": [], "Criticality": 8, "EventIDs": [12, 13, 14], "Schema": "1.0.0"}, "Name": "Sigma: Potential Persistence Via Outlook LoadMacroProviderOnBoot Setting", "Tags": ["Sigma", "SigmaHQ", "T1137", "T1008", "T1546"]}
{"Condition": "($selection_commandline)", "Matches": ["$selection_commandline: CommandLine ~= '(?:(?i:h\\^t\\^t\\^p)|(?i:h\"t\"t\"p))'"], "Meta": {"Author": "juju4", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects potential commandline obfuscation using known escape characters (source: proc_creation_win_susp_cli_obfuscation_escape_char.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Potential Commandline Obfuscation Using Escape Characters", "Tags": ["Sigma", "SigmaHQ", "T1140"]}
{"Condition": "($selection_image and $selection_commandline)", "Matches": ["$selection_image: Image ~= '(?:(?i:\\\\brave\\.exe$)|(?i:\\\\chrome\\.exe$)|(?i:\\\\msedge\\.exe$)|(?i:\\\\opera\\.exe$)|(?i:\\\\vivaldi\\.exe$))'", "$selection_commandline: CommandLine ~= '(?i:\\-\\-load\\-extension=)'"], "Meta": {"Author": "Aedan Russell, frack113, X__Junior (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects a Chromium based browser process with the 'load-extension' flag to start a instance with a custom extension (source: proc_creation_win_browsers_chromium_load_extension.yml)", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Chromium Browser Instance Executed With Custom Extension", "Tags": ["Sigma", "SigmaHQ", "T1176.001"]}
{"Condition": "($selection_image and $selection_targetfilename and $selection_targetfilename_2 and $selection_targetfilename_3)", "Matches": ["$selection_image: Image ~= '(?:(?i:\\\\cmd\\.exe$)|(?i:\\\\powershell_ise\\.exe$)|(?i:\\\\powershell\\.exe$)|(?i:\\\\pwsh\\.exe$)|(?i:\\\\w3wp\\.exe$))'", "$selection_targetfilename: TargetFilename ~= '(?:(?i:^C:\\\\Program\\ Files\\\\Common\\ Files\\\\Microsoft\\ Shared\\\\Web\\ Server\\ Extensions\\\\)|(?i:^C:\\\\Program\\ Files\\ \\(x86\\)\\\\Common\\ Files\\\\Microsoft\\ Shared\\\\Web\\ Server\\ Extensions\\\\))'", "$selection_targetfilename_2: TargetFilename ~= '(?:(?i:\\\\15\\\\TEMPLATE\\\\LAYOUTS\\\\)|(?i:\\\\16\\\\TEMPLATE\\\\LAYOUTS\\\\))'", "$selection_targetfilename_3: TargetFilename ~= '(?:(?i:\\.asax$)|(?i:\\.ascx$)|(?i:\\.ashx$)|(?i:\\.asmx$)|(?i:\\.asp$)|(?i:\\.aspx$)|(?i:\\.bat$)|(?i:\\.cmd$)|(?i:\\.cer$)|(?i:\\.config$)|(?i:\\.hta$)|(?i:\\.js$)|(?i:\\.jsp$)|(?i:\\.jspx$)|(?i:\\.php$)|(?i:\\.ps1$)|(?i:\\.vbs$))'"], "Meta": {"Author": "Swachchhanda Shrawan Poudel (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects suspicious file writes to SharePoint layouts directory which could indicate webshell activity or post-exploitation.\nThis behavior has been observed in the exploitation of SharePoint vulnerabilities such as CVE-2025-49704, CVE-2025-49706 or CVE-2025-53770.\n (source: file_event_win_susp_filewr", "Computers": [], "Criticality": 8, "EventIDs": [11], "Schema": "1.0.0"}, "Name": "Sigma: Suspicious File Write to SharePoint Layouts Directory", "Tags": ["Sigma", "SigmaHQ", "T1190", "T1505.003"]}
{"Condition": "($selection_image and $selection_imageloaded)", "Matches": ["$selection_image: Image ~= '(?i:\\\\msdt\\.exe$)'", "$selection_imageloaded: ImageLoaded ~= '(?i:\\\\sdiageng\\.dll$)'"], "Meta": {"Author": "Greg (rule)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects both of CVE-2022-30190 (Follina) and DogWalk vulnerabilities exploiting msdt.exe binary to load the \"sdiageng.dll\" library (source: image_load_dll_sdiageng_load_by_msdt.yml)", "Computers": [], "Criticality": 8, "EventIDs": [7], "Schema": "1.0.0"}, "Name": "Sigma: Diagnostic Library Sdiageng.DLL Loaded By Msdt.EXE", "Tags": ["Sigma", "SigmaHQ", "T1202"]}
{"Condition": "($selection_commandline) and ! ($filter_commandline)", "Matches": ["$selection_commandline: CommandLine ~= '(?i:\\.SettingContent\\-ms)'", "$filter_commandline: CommandLine ~= '(?i:immersivecontrolpanel)'"], "Meta": {"Author": "Sreeman", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "The .SettingContent-ms file type was introduced in Windows 10 and allows a user to create \"shortcuts\" to various Windows 10 setting pages. These files are simply XML and contain paths to various Windows 10 settings binaries. (source: proc_creation_win_susp_arbitrary_shell_execution_via_settingconten", "Computers": [], "Criticality": 6, "EventIDs": [1], "Schema": "1.0.0"}, "Name": "Sigma: Arbitrary Shell Command Execution Via Settingcontent-Ms", "Tags": ["Sigma", "SigmaHQ", "T1204", "T1566.001"]}
{"Condition": "($selection_sourceimage and $selection_calltrace_all0 and $selection_calltrace_all1)", "Matches": ["$selection_sourceimage: SourceImage ~= '(?i:\\\\winword\\.exe$)'", "$selection_calltrace_all0: CallTrace ~= '(?i::\\\\Windows\\\\Microsoft\\.NET\\\\Framework64\\\\v2\\.)'", "$selection_calltrace_all1: CallTrace ~= '(?i:UNKNOWN)'"], "Meta": {"Author": "Christian Burkard (Nextron Systems)", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects the process injection of a LittleCorporal generated Maldoc. (source: proc_access_win_hktl_littlecorporal_generated_maldoc.yml)", "Computers": [], "Criticality": 8, "EventIDs": [10], "Schema": "1.0.0"}, "Name": "Sigma: HackTool - LittleCorporal Generated Maldoc Injection", "Tags": ["Sigma", "SigmaHQ", "T1204.002", "T1055.003"]}
{"Condition": "($system_files_targetfilename) and ! ($in_system_folder_targetfilename)", "Matches": ["$system_files_targetfilename: TargetFilename ~= '(?:(?i:WsmPty\\.xsl$)|(?i:WsmTxt\\.xsl$))'", "$in_system_folder_targetfilename: TargetFilename ~= '(?:(?i:^C:\\\\Windows\\\\System32\\\\)|(?i:^C:\\\\Windows\\\\SysWOW64\\\\))'"], "Meta": {"Author": "Julia Fomina, oscd.community", "Channels": ["Microsoft-Windows-Sysmon/Operational"], "Comment": "Detects execution of attacker-controlled WsmPty.xsl or WsmTxt.xsl via winrm.vbs and copied cscript.exe (can be renamed) (source: file_event_win_winrm_awl_bypass.yml)", "Computers": [], "Criticality": 6, "EventIDs": [11], "Schema": "1.0.0"}, "Name": "Sigma: AWL Bypass with Winrm.vbs and Malicious WsmPty.xsl/WsmTxt.xsl - File", "Tags": ["Sigma", "SigmaHQ", "T1216"]}
